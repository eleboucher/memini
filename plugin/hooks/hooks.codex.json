{
  "description": "Codex-native lifecycle wiring. Installing does not trust hooks automatically; review /hooks before enabling them.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run.sh\" \"${PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/scripts/session-start.mjs\"",
            "statusMessage": "memini: loading session context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run.sh\" \"${PLUGIN_ROOT}/scripts/user-prompt-submit.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/scripts/user-prompt-submit.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run.sh\" \"${PLUGIN_ROOT}/scripts/stop.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/scripts/stop.mjs\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run.sh\" \"${PLUGIN_ROOT}/scripts/pre-compact.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/scripts/pre-compact.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run.sh\" \"${PLUGIN_ROOT}/scripts/pre-tool-use.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/scripts/pre-tool-use.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash|mcp__.*memini.*__memory_(recall|briefing|get)",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/run.sh\" \"${PLUGIN_ROOT}/scripts/post-tool-use.mjs\"",
            "commandWindows": "node \"${PLUGIN_ROOT}/scripts/post-tool-use.mjs\""
          }
        ]
      }
    ]
  }
}
