{
  "name": "@eleboucher/memini",
  "version": "0.7.5",
  "private": true,
  "files": [
    "dist",
    "openclaw.plugin.json",
    "plugin.yaml"
  ],
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:typebox --external:openclaw --alias:@memini/client=../../../packages/memini-client/src/index.ts --outfile=dist/index.js",
    "test": "node --test test/regression.test.mjs test/bundle.test.mjs && npx tsx --test test/helpers.test.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "openclaw": "latest",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.6.8"
    },
    "release": {
      "publishToClawHub": true
    }
  }
}
