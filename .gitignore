/bin/
/dist/
# UI artifacts. The Vite bundle is generated, not committed; .gitkeep stays so
# //go:embed all:dist compiles.
/ui/node_modules/
# Node deps for the JS integration plugins (e.g. openclaw's typebox); declared in
# package.json, installed on demand, never committed.
node_modules/
# Python bytecode from running the Hermes plugin/tests.
__pycache__/
# Playwright MCP debug artifacts (snapshots, screenshots, console logs).
/.playwright-mcp/
/internal/api/ui/dist/*
!/internal/api/ui/dist/.gitkeep
*.db
*.db-shm
*.db-wal
memini.db*
/tmp/
cover.out
coverage.out
.env
# Benchmark run outputs (generated; not part of the repo).
/bench/results/
# Local agent session notes.
/.remember/

# Stray QA benchmark checkpoints and built command binaries.
qa_*.jsonl
/locomo-qa
/memini

# Helm subchart download dir; the memini chart's dependency tarballs are
# deliberately vendored (committed) so CI/release never fetches from the
# flaky GitHub Pages helm repo — see the "Verify vendored chart
# dependencies" step. Everything else under charts/*/charts/ stays ignored.
/charts/*/charts/*
!/charts/memini/charts/*.tgz
.bench-mining/

# Deepwork session state (local planning, not committed).
.slim/deepwork/
# Build output for every workspace package. Note this does NOT cover
# plugin/scripts/_client.gen.mjs, which is generated from packages/memini-client
# but is deliberately COMMITTED — the plugin ships as raw files with no
# install-time build step, and `mise run client-check` gates it against drift.
packages/*/dist/
packages/*/node_modules/
.superpowers/
# Local Claude Code session state (skills, worktrees, settings), same as the
# other local agent directories above.
/.claude/

# Stray build output from `go build ./cmd/gendocs`.
/gendocs
