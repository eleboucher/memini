/bin/
/dist/
# UI artifacts. The Vite bundle is generated, not committed; .gitkeep stays so
# //go:embed all:dist compiles.
/ui/node_modules/
# Node deps for the JS integration plugins (e.g. openclaw's typebox); declared in
# package.json, installed on demand, never committed.
node_modules/
# Python bytecode from running the Hermes plugin/tests.
__pycache__/
/internal/api/ui/dist/*
!/internal/api/ui/dist/.gitkeep
*.db
*.db-shm
*.db-wal
memini.db*
/tmp/
cover.out
coverage.out
.env
# Benchmark run outputs (generated; not part of the repo).
/bench/results/
# Local agent session notes.
/.remember/

# Stray QA benchmark checkpoints and built command binaries.
qa_*.jsonl
/locomo-qa
/memini
