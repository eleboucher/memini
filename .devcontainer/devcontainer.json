{
  "name": "memini",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/jdx/mise:1": {}
  },
  "postCreateCommand": "mise trust && mise install",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml", "redhat.vscode-yaml"]
    }
  },
  "remoteUser": "vscode"
}
