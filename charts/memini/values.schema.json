{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "controllers": {
      "properties": {
        "fsck": {
          "description": "Periodic fsck CronJob. Disabled by default — the in-process sweeper\nalready handles decay. If enabled, the container needs MEMINI_API_KEY in env\nand uses curl's --variable/--expand-header so the token never lands in argv.",
          "properties": {
            "containers": {
              "properties": {
                "fsck": {
                  "properties": {
                    "command": {
                      "items": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "string"
                          },
                          {
                            "type": "string"
                          }
                        ],
                        "required": []
                      },
                      "title": "command",
                      "type": "array"
                    },
                    "image": {
                      "properties": {
                        "pullPolicy": {
                          "default": "IfNotPresent",
                          "title": "pullPolicy",
                          "type": "string"
                        },
                        "repository": {
                          "default": "curlimages/curl",
                          "title": "repository",
                          "type": "string"
                        },
                        "tag": {
                          "default": "8.20.0",
                          "title": "tag",
                          "type": "string"
                        }
                      },
                      "required": [],
                      "title": "image",
                      "type": "object"
                    },
                    "securityContext": {
                      "description": "Provide the bearer token to the curl --variable above. Point at the\nsame Secret as the main container's MEMINI_API_KEY.\nenv:\n  MEMINI_API_KEY:\n    valueFrom:\n      secretKeyRef:\n        name: memini-auth\n        key: api-key",
                      "properties": {
                        "allowPrivilegeEscalation": {
                          "default": false,
                          "title": "allowPrivilegeEscalation",
                          "type": "boolean"
                        },
                        "capabilities": {
                          "properties": {
                            "drop": {
                              "items": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  }
                                ],
                                "required": []
                              },
                              "title": "drop",
                              "type": "array"
                            }
                          },
                          "required": [],
                          "title": "capabilities",
                          "type": "object"
                        },
                        "readOnlyRootFilesystem": {
                          "default": true,
                          "title": "readOnlyRootFilesystem",
                          "type": "boolean"
                        }
                      },
                      "required": [],
                      "title": "securityContext",
                      "type": "object"
                    }
                  },
                  "required": [],
                  "title": "fsck",
                  "type": "object"
                }
              },
              "required": [],
              "title": "containers",
              "type": "object"
            },
            "cronjob": {
              "properties": {
                "concurrencyPolicy": {
                  "default": "Forbid",
                  "title": "concurrencyPolicy",
                  "type": "string"
                },
                "schedule": {
                  "default": "0 * * * *",
                  "title": "schedule",
                  "type": "string"
                }
              },
              "required": [],
              "title": "cronjob",
              "type": "object"
            },
            "enabled": {
              "default": false,
              "title": "enabled",
              "type": "boolean"
            },
            "pod": {
              "properties": {
                "securityContext": {
                  "properties": {
                    "runAsNonRoot": {
                      "default": true,
                      "title": "runAsNonRoot",
                      "type": "boolean"
                    },
                    "runAsUser": {
                      "default": 65532,
                      "title": "runAsUser",
                      "type": "integer"
                    }
                  },
                  "required": [],
                  "title": "securityContext",
                  "type": "object"
                }
              },
              "required": [],
              "title": "pod",
              "type": "object"
            },
            "type": {
              "default": "cronjob",
              "title": "type",
              "type": "string"
            }
          },
          "required": [],
          "title": "fsck",
          "type": "object"
        },
        "main": {
          "properties": {
            "containers": {
              "description": "HorizontalPodAutoscaler (postgres / deployment backend only — sqlite is\nsingle-writer). Uncomment after switching type to `deployment`:\nhorizontalPodAutoscaler:\n  minReplicas: 2\n  maxReplicas: 10\n  metrics:\n    - type: Resource\n      resource:\n        name: cpu\n        target:\n          type: Utilization\n          averageUtilization: 80",
              "properties": {
                "main": {
                  "properties": {
                    "env": {
                      "description": "Environment variables (MEMINI_*). Dictionary style. The always-on\ndefaults below configure the sqlite backend; commented entries are\noptional knobs operators can uncomment.",
                      "properties": {
                        "MEMINI_BACKEND": {
                          "default": "sqlite",
                          "description": "Storage backend: \"sqlite\" (default) or \"postgres\". For postgres,\nset this to \"postgres\", switch controllers.main.type to deployment,\ndisable persistence.data, and wire MEMINI_POSTGRES_DSN below.",
                          "title": "MEMINI_BACKEND",
                          "type": "string"
                        },
                        "MEMINI_DEFAULT_NAMESPACE": {
                          "default": "default",
                          "description": "Default namespace for memories.",
                          "title": "MEMINI_DEFAULT_NAMESPACE",
                          "type": "string"
                        },
                        "MEMINI_EMBED_BASE_URL": {
                          "default": "",
                          "description": "OpenAI-compatible embeddings endpoint (required for vector search).",
                          "title": "MEMINI_EMBED_BASE_URL",
                          "type": "string"
                        },
                        "MEMINI_EMBED_DIMS": {
                          "default": "1536",
                          "description": "Embedding dimensionality; MUST match the deployed model.",
                          "title": "MEMINI_EMBED_DIMS",
                          "type": "string"
                        },
                        "MEMINI_EMBED_MODEL": {
                          "default": "text-embedding-3-small",
                          "description": "Embedding model name.",
                          "title": "MEMINI_EMBED_MODEL",
                          "type": "string"
                        },
                        "MEMINI_HTTP_ADDR": {
                          "default": ":8080",
                          "description": "HTTP listen address.",
                          "title": "MEMINI_HTTP_ADDR",
                          "type": "string"
                        },
                        "MEMINI_LOG_FORMAT": {
                          "default": "json",
                          "description": "Log format (json|text).",
                          "title": "MEMINI_LOG_FORMAT",
                          "type": "string"
                        },
                        "MEMINI_LOG_LEVEL": {
                          "default": "info",
                          "description": "Log level.",
                          "title": "MEMINI_LOG_LEVEL",
                          "type": "string"
                        },
                        "MEMINI_METRICS_ADDR": {
                          "default": ":9090",
                          "description": "Dedicated metrics listener; keeps /metrics off the main port and\nevery route, so it needs no bearer token. \"\" serves it on the main port.",
                          "title": "MEMINI_METRICS_ADDR",
                          "type": "string"
                        },
                        "MEMINI_NAMESPACE_HEADER": {
                          "default": "X-Memini-Namespace",
                          "description": "HTTP header that selects the namespace per request.",
                          "title": "MEMINI_NAMESPACE_HEADER",
                          "type": "string"
                        },
                        "MEMINI_SQLITE_PATH": {
                          "default": "/data/memini.db",
                          "description": "sqlite database path (kept on the PVC mounted at /data).",
                          "title": "MEMINI_SQLITE_PATH",
                          "type": "string"
                        },
                        "MEMINI_SWEEP_INTERVAL": {
                          "default": "1h",
                          "description": "Decay sweeper interval (Go duration).",
                          "title": "MEMINI_SWEEP_INTERVAL",
                          "type": "string"
                        },
                        "MEMINI_UI_ENABLED": {
                          "default": "true",
                          "description": "Serve the embedded admin SPA at /. Set \"false\" for headless API/MCP.",
                          "title": "MEMINI_UI_ENABLED",
                          "type": "string"
                        }
                      },
                      "required": [],
                      "title": "env",
                      "type": "object"
                    },
                    "image": {
                      "properties": {
                        "digest": {
                          "default": "",
                          "description": "Image digest (sha256:...); takes precedence over tag when set.\nThe release pipeline rewrites this line.",
                          "title": "digest",
                          "type": "string"
                        },
                        "pullPolicy": {
                          "default": "IfNotPresent",
                          "description": "Image pull policy.",
                          "title": "pullPolicy",
                          "type": "string"
                        },
                        "repository": {
                          "default": "registry.erwanleboucher.dev/eleboucher/memini",
                          "description": "Container image repository.",
                          "title": "repository",
                          "type": "string"
                        },
                        "tag": {
                          "default": "",
                          "description": "Image tag. Empty falls back to the chart appVersion.",
                          "title": "tag",
                          "type": "string"
                        }
                      },
                      "required": [],
                      "title": "image",
                      "type": "object"
                    },
                    "probes": {
                      "description": "Container probes. Liveness hits /healthz, readiness hits /readyz.",
                      "properties": {
                        "liveness": {
                          "properties": {
                            "custom": {
                              "default": true,
                              "title": "custom",
                              "type": "boolean"
                            },
                            "enabled": {
                              "default": true,
                              "title": "enabled",
                              "type": "boolean"
                            },
                            "spec": {
                              "properties": {
                                "httpGet": {
                                  "properties": {
                                    "path": {
                                      "default": "/healthz",
                                      "title": "path",
                                      "type": "string"
                                    },
                                    "port": {
                                      "default": 8080,
                                      "title": "port",
                                      "type": "integer"
                                    }
                                  },
                                  "required": [],
                                  "title": "httpGet",
                                  "type": "object"
                                },
                                "initialDelaySeconds": {
                                  "default": 5,
                                  "title": "initialDelaySeconds",
                                  "type": "integer"
                                },
                                "periodSeconds": {
                                  "default": 15,
                                  "title": "periodSeconds",
                                  "type": "integer"
                                }
                              },
                              "required": [],
                              "title": "spec",
                              "type": "object"
                            }
                          },
                          "required": [],
                          "title": "liveness",
                          "type": "object"
                        },
                        "readiness": {
                          "properties": {
                            "custom": {
                              "default": true,
                              "title": "custom",
                              "type": "boolean"
                            },
                            "enabled": {
                              "default": true,
                              "title": "enabled",
                              "type": "boolean"
                            },
                            "spec": {
                              "properties": {
                                "httpGet": {
                                  "properties": {
                                    "path": {
                                      "default": "/readyz",
                                      "title": "path",
                                      "type": "string"
                                    },
                                    "port": {
                                      "default": 8080,
                                      "title": "port",
                                      "type": "integer"
                                    }
                                  },
                                  "required": [],
                                  "title": "httpGet",
                                  "type": "object"
                                },
                                "initialDelaySeconds": {
                                  "default": 3,
                                  "title": "initialDelaySeconds",
                                  "type": "integer"
                                },
                                "periodSeconds": {
                                  "default": 10,
                                  "title": "periodSeconds",
                                  "type": "integer"
                                }
                              },
                              "required": [],
                              "title": "spec",
                              "type": "object"
                            }
                          },
                          "required": [],
                          "title": "readiness",
                          "type": "object"
                        }
                      },
                      "required": [],
                      "title": "probes",
                      "type": "object"
                    },
                    "securityContext": {
                      "description": "Container security context.",
                      "properties": {
                        "allowPrivilegeEscalation": {
                          "default": false,
                          "title": "allowPrivilegeEscalation",
                          "type": "boolean"
                        },
                        "capabilities": {
                          "properties": {
                            "drop": {
                              "items": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  }
                                ],
                                "required": []
                              },
                              "title": "drop",
                              "type": "array"
                            }
                          },
                          "required": [],
                          "title": "capabilities",
                          "type": "object"
                        },
                        "readOnlyRootFilesystem": {
                          "default": true,
                          "title": "readOnlyRootFilesystem",
                          "type": "boolean"
                        }
                      },
                      "required": [],
                      "title": "securityContext",
                      "type": "object"
                    }
                  },
                  "required": [],
                  "title": "main",
                  "type": "object"
                }
              },
              "required": [],
              "title": "containers",
              "type": "object"
            },
            "pod": {
              "properties": {
                "securityContext": {
                  "description": "Pod-level security context.",
                  "properties": {
                    "fsGroup": {
                      "default": 65532,
                      "title": "fsGroup",
                      "type": "integer"
                    },
                    "runAsNonRoot": {
                      "default": true,
                      "title": "runAsNonRoot",
                      "type": "boolean"
                    },
                    "runAsUser": {
                      "default": 65532,
                      "title": "runAsUser",
                      "type": "integer"
                    }
                  },
                  "required": [],
                  "title": "securityContext",
                  "type": "object"
                }
              },
              "required": [],
              "title": "pod",
              "type": "object"
            },
            "replicas": {
              "default": 1,
              "description": "Replica count. sqlite is single-writer so keep at 1. With postgres\n(type: deployment) you can scale out, or drive it via horizontalPodAutoscaler.",
              "title": "replicas",
              "type": "integer"
            },
            "type": {
              "default": "statefulset",
              "description": "Controller type. `statefulset` for the default sqlite backend (PVC at\n/data, single replica). For the postgres backend switch this to\n`deployment` (no PVC, scale-out) — see env MEMINI_BACKEND below.",
              "title": "type",
              "type": "string"
            }
          },
          "required": [],
          "title": "main",
          "type": "object"
        }
      },
      "required": [],
      "title": "controllers",
      "type": "object"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "grafanaDashboards": {
      "description": "Bundled Grafana dashboards, rendered as ConfigMaps for the grafana-operator\n(a custom chart key, not part of the common library). Point your Grafana CR's\n`dashboardsConfigMaps` selector at this release's namespace; the operator picks\nup any ConfigMap labelled `grafana_dashboard: \"1\"`.",
      "properties": {
        "enabled": {
          "default": false,
          "description": "Render the bundled dashboard as a ConfigMap.",
          "title": "enabled",
          "type": "boolean"
        },
        "folder": {
          "default": "memini",
          "description": "grafana_dashboard_folder annotation; controls where it lands in Grafana.",
          "title": "folder",
          "type": "string"
        }
      },
      "required": [],
      "title": "grafanaDashboards",
      "type": "object"
    },
    "persistence": {
      "description": "Persistent storage for the sqlite backend, mounted at /data. A standalone\nPVC (single-replica memini sqlite is single-writer). For the postgres backend\nset `persistence.data.enabled: false`.",
      "properties": {
        "data": {
          "properties": {
            "accessMode": {
              "default": "ReadWriteOnce",
              "title": "accessMode",
              "type": "string"
            },
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            },
            "globalMounts": {
              "description": "Attach a pre-created PVC instead (e.g. restored by VolSync). When set,\nsize/accessMode are ignored.\nexistingClaim: memini-data\nStorage class; null uses the cluster default.\nstorageClass: \"\"",
              "items": {
                "anyOf": [
                  {
                    "properties": {
                      "path": {
                        "default": "/data",
                        "title": "path",
                        "type": "string"
                      }
                    },
                    "required": [],
                    "type": "object"
                  }
                ],
                "required": []
              },
              "title": "globalMounts",
              "type": "array"
            },
            "size": {
              "default": "5Gi",
              "title": "size",
              "type": "string"
            },
            "type": {
              "default": "persistentVolumeClaim",
              "title": "type",
              "type": "string"
            }
          },
          "required": [],
          "title": "data",
          "type": "object"
        }
      },
      "required": [],
      "title": "persistence",
      "type": "object"
    },
    "route": {
      "description": "Gateway API HTTPRoutes (the modern replacement for Ingress). BOTH disabled\nby default — the operator enables and attaches them to an existing Gateway.\nExposing /v1 or /mcp REQUIRES bearer auth: set MEMINI_API_KEY (see env above).",
      "properties": {
        "internal": {
          "description": "Internal catch-all surface (full app incl. the UI shell, which embeds the\nAPI key). Keep this on an internal-only gateway.",
          "properties": {
            "enabled": {
              "default": false,
              "title": "enabled",
              "type": "boolean"
            },
            "hostnames": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "title": "hostnames",
              "type": "array"
            },
            "kind": {
              "default": "HTTPRoute",
              "title": "kind",
              "type": "string"
            },
            "parentRefs": {
              "items": {
                "anyOf": [
                  {
                    "properties": {
                      "name": {
                        "default": "envoy-internal",
                        "title": "name",
                        "type": "string"
                      },
                      "namespace": {
                        "default": "network",
                        "title": "namespace",
                        "type": "string"
                      },
                      "sectionName": {
                        "default": "https",
                        "title": "sectionName",
                        "type": "string"
                      }
                    },
                    "required": [],
                    "type": "object"
                  }
                ],
                "required": []
              },
              "title": "parentRefs",
              "type": "array"
            },
            "rules": {
              "items": {
                "anyOf": [
                  {
                    "properties": {
                      "backendRefs": {
                        "items": {
                          "anyOf": [
                            {
                              "properties": {
                                "identifier": {
                                  "default": "main",
                                  "title": "identifier",
                                  "type": "string"
                                },
                                "port": {
                                  "default": "http",
                                  "title": "port",
                                  "type": "string"
                                }
                              },
                              "required": [],
                              "type": "object"
                            }
                          ],
                          "required": []
                        },
                        "title": "backendRefs",
                        "type": "array"
                      }
                    },
                    "required": [],
                    "type": "object"
                  }
                ],
                "required": []
              },
              "title": "rules",
              "type": "array"
            }
          },
          "required": [],
          "title": "internal",
          "type": "object"
        },
        "main": {
          "description": "Public API + MCP surface. Enable, set the gateway in parentRefs, and the\nhostname, then scope to the token-gated paths via rules[].matches.",
          "properties": {
            "enabled": {
              "default": false,
              "title": "enabled",
              "type": "boolean"
            },
            "hostnames": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "title": "hostnames",
              "type": "array"
            },
            "kind": {
              "default": "HTTPRoute",
              "title": "kind",
              "type": "string"
            },
            "parentRefs": {
              "items": {
                "anyOf": [
                  {
                    "properties": {
                      "name": {
                        "default": "envoy-external",
                        "title": "name",
                        "type": "string"
                      },
                      "namespace": {
                        "default": "network",
                        "title": "namespace",
                        "type": "string"
                      },
                      "sectionName": {
                        "default": "https",
                        "title": "sectionName",
                        "type": "string"
                      }
                    },
                    "required": [],
                    "type": "object"
                  }
                ],
                "required": []
              },
              "title": "parentRefs",
              "type": "array"
            },
            "rules": {
              "items": {
                "anyOf": [
                  {
                    "properties": {
                      "backendRefs": {
                        "items": {
                          "anyOf": [
                            {
                              "properties": {
                                "identifier": {
                                  "default": "main",
                                  "title": "identifier",
                                  "type": "string"
                                },
                                "port": {
                                  "default": "http",
                                  "title": "port",
                                  "type": "string"
                                }
                              },
                              "required": [],
                              "type": "object"
                            }
                          ],
                          "required": []
                        },
                        "title": "backendRefs",
                        "type": "array"
                      },
                      "matches": {
                        "items": {
                          "anyOf": [
                            {
                              "properties": {
                                "path": {
                                  "properties": {
                                    "type": {
                                      "default": "PathPrefix",
                                      "title": "type",
                                      "type": "string"
                                    },
                                    "value": {
                                      "default": "/v1",
                                      "title": "value",
                                      "type": "string"
                                    }
                                  },
                                  "required": [],
                                  "title": "path",
                                  "type": "object"
                                }
                              },
                              "required": [],
                              "type": "object"
                            },
                            {
                              "properties": {
                                "path": {
                                  "properties": {
                                    "type": {
                                      "default": "PathPrefix",
                                      "title": "type",
                                      "type": "string"
                                    },
                                    "value": {
                                      "default": "/mcp",
                                      "title": "value",
                                      "type": "string"
                                    }
                                  },
                                  "required": [],
                                  "title": "path",
                                  "type": "object"
                                }
                              },
                              "required": [],
                              "type": "object"
                            },
                            {
                              "properties": {
                                "path": {
                                  "properties": {
                                    "type": {
                                      "default": "PathPrefix",
                                      "title": "type",
                                      "type": "string"
                                    },
                                    "value": {
                                      "default": "/.well-known/",
                                      "title": "value",
                                      "type": "string"
                                    }
                                  },
                                  "required": [],
                                  "title": "path",
                                  "type": "object"
                                }
                              },
                              "required": [],
                              "type": "object"
                            }
                          ],
                          "required": []
                        },
                        "title": "matches",
                        "type": "array"
                      }
                    },
                    "required": [],
                    "type": "object"
                  }
                ],
                "required": []
              },
              "title": "rules",
              "type": "array"
            }
          },
          "required": [],
          "title": "main",
          "type": "object"
        }
      },
      "required": [],
      "title": "route",
      "type": "object"
    },
    "service": {
      "properties": {
        "main": {
          "properties": {
            "controller": {
              "default": "main",
              "description": "Primary Service. Targets the main controller. Common derives the\ncontainer ports from these ports.",
              "title": "controller",
              "type": "string"
            },
            "ports": {
              "properties": {
                "http": {
                  "properties": {
                    "port": {
                      "default": 8080,
                      "title": "port",
                      "type": "integer"
                    },
                    "primary": {
                      "default": true,
                      "title": "primary",
                      "type": "boolean"
                    }
                  },
                  "required": [],
                  "title": "http",
                  "type": "object"
                },
                "metrics": {
                  "description": "Dedicated metrics port (MEMINI_METRICS_ADDR). Not referenced by any\nroute, so /metrics stays in-cluster.",
                  "properties": {
                    "port": {
                      "default": 9090,
                      "title": "port",
                      "type": "integer"
                    }
                  },
                  "required": [],
                  "title": "metrics",
                  "type": "object"
                }
              },
              "required": [],
              "title": "ports",
              "type": "object"
            }
